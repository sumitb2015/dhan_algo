# Kotak Neo credentials — copy to .env.kotak and fill in.
#
# KOTAK_CONSUMER_KEY : Neo app -> Invest -> Trade API card -> Generate application
# KOTAK_MOBILE_NUMBER: include the country code, e.g. +9198xxxxxxxx
# KOTAK_UCC          : your Unique Client Code
# KOTAK_MPIN         : 6-digit MPIN
# KOTAK_TOTP_SECRET  : the authenticator secret from Kotak's TOTP registration
#                      (register TOTP on the Neo portal first)

KOTAK_CONSUMER_KEY=
KOTAK_MOBILE_NUMBER=
KOTAK_UCC=
KOTAK_MPIN=
KOTAK_TOTP_SECRET=
